{
    "name": "warmar/laravel-blog",
    "description": "A blog/news plugin for Laravel + Livewire",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "warmar"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelBlog\\": "src/"
        },
        "exclude-from-classmap": [
            "src/app/"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelBlog\\LaravelBlogServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}